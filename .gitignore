# ==================================================
# DeepGuard AI - Global .gitignore
# ==================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*.so
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---------- Virtual Environments ----------
.venv/
.venv-1/
venv/
env/

# ---------- Environment Variables ----------
.env
.env.*
!.env.example

# ---------- Logs ----------
logs/
*.log

# ---------- Runtime Data ----------
uploads/
app/uploads/
app/logs/

# ---------- Google ADK ----------
.adk/
.saved_chats/
.persist_vector_store/

# ---------- Node ----------
node_modules/
dist/
build/
coverage/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- React ----------
frontend/dist/
frontend/node_modules/

# ---------- IDE ----------
.vscode/
.idea/
*.iml

# ---------- OS ----------
.DS_Store
Thumbs.db

# ---------- Deployment ----------
.terraform/
*.tfstate

# ---------- Docker ----------
docker-compose.override.yml

# ---------- Evaluation Dataset (keep structure, never commit media) ----------
eval_dataset/images/*/[!.]*
eval_dataset/videos/*/[!.]*

# ---------- Temporary ----------
*.tmp
*.bak
*.swp
