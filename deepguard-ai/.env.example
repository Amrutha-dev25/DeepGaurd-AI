# ==================================================
# DeepGuard AI — Environment Configuration (example)
# Copy this file to .env and fill in your API keys.
# ==================================================

# ── Analysis Primary: Sightengine (deepfake detection API) ──────────
SIGHTENGINE_API_USER=YOUR_SIGHTENGINE_USER
SIGHTENGINE_API_SECRET=YOUR_SIGHTENGINE_SECRET
SIGHTENGINE_API_URL=https://api.sightengine.com/1.0/check.json

# ── Google / Gemini (Supervisor + conditional fallback) ─────────────
GOOGLE_API_KEY=YOUR_GOOGLE_KEY
ENABLE_GEMINI_FALLBACK=true
FALLBACK2_MODEL=gemini-2.5-flash

# ── Router Agent (Groq primary, NVIDIA/Gemini fallback) ────────────
ROUTER_MODEL=groq/llama-3.3-70b-versatile
ROUTER_API_KEY=YOUR_GROQ_KEY
ROUTER_ENDPOINT=https://api.groq.com/openai/v1

ROUTER_FALLBACK1_MODEL=gemini-2.5-flash
ROUTER_FALLBACK2_MODEL=nvidia_nim/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
ROUTER_FALLBACK2_API_KEY=YOUR_NVIDIA_KEY
ROUTER_FALLBACK2_ENDPOINT=https://integrate.api.nvidia.com/v1
ROUTER_FALLBACK3_MODEL=nvidia_nim/nvidia/nemotron-nano-12b-v2-vl
ROUTER_FALLBACK3_API_KEY=YOUR_NVIDIA_KEY
ROUTER_FALLBACK3_ENDPOINT=https://integrate.api.nvidia.com/v1

# ── Analysis Agents (supervisor-dispatched) ─────────────────────────
PRIMARY_MODEL=nvidia_nim/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
PRIMARY_API_KEY=YOUR_NVIDIA_KEY
PRIMARY_ENDPOINT=https://integrate.api.nvidia.com/v1

FALLBACK1_MODEL=nvidia_nim/nvidia/nemotron-nano-12b-v2-vl
FALLBACK1_API_KEY=YOUR_NVIDIA_KEY
FALLBACK1_ENDPOINT=https://integrate.api.nvidia.com/v1

# ── Report Agent (Groq primary, NVIDIA/Gemini fallback) ─────────────
REPORT_MODEL=groq/llama-3.3-70b-versatile
GROQ_API_KEY=YOUR_GROQ_KEY

REPORT_FALLBACK1_MODEL=gemini-2.5-flash
REPORT_FALLBACK2_MODEL=nvidia_nim/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
REPORT_FALLBACK2_API_KEY=YOUR_NVIDIA_KEY
REPORT_FALLBACK2_ENDPOINT=https://integrate.api.nvidia.com/v1
REPORT_FALLBACK3_MODEL=nvidia_nim/nvidia/nemotron-nano-12b-v2-vl
REPORT_FALLBACK3_API_KEY=YOUR_NVIDIA_KEY
REPORT_FALLBACK3_ENDPOINT=https://integrate.api.nvidia.com/v1

# ── Supervisor: Gemini (sole provider, no Cerebras) ────────────────
SUPERVISOR_MODEL=gemini-2.5-flash

# ── Web Search (Optional — Report Agent tool) ──────────────────────
TAVILY_API_KEY=YOUR_TAVILY_KEY

# ── Pipeline Tuning ────────────────────────────────────────────────
MAX_RETRIES_PRIMARY=2
REQUEST_TIMEOUT_SECONDS=120
MAX_FILE_SIZE_MB=100
RATE_LIMIT_PER_MINUTE=20

# ── Preprocessing Defaults ─────────────────────────────────────────
IMAGE_TARGET_SIZE=384
CLAHE_CLIP_LIMIT=2.0
DENOISE_STRENGTH=10
ELA_QUALITY=95
VIDEO_MAX_FRAMES=30
VIDEO_INFORMATIVE_FRAMES=10

# ── Security ───────────────────────────────────────────────────────
PII_REDACTION_ENABLED=true
INJECTION_DETECTION_ENABLED=true

# ── CORS (production) ──────────────────────────────────────────────
FRONTEND_URL="https://your-vercel-app.vercel.app"
CORS_ORIGINS=""

# ── Logging ────────────────────────────────────────────────────────
LOG_LEVEL="INFO"
