# ==================================================
# DeepGuard AI — Environment Configuration (example)
# ==================================================

# ── Analysis Primary: Sightengine (deepfake detection API) ──────────
SIGHTENGINE_API_USER=YOUR_SIGHTENGINE_USER
SIGHTENGINE_API_SECRET=YOUR_SIGHTENGINE_SECRET
SIGHTENGINE_API_URL=https://api.sightengine.com/1.0/check.json

GOOGLE_API_KEY=YOUR_GOOGLE_KEY

ENABLE_GEMINI_FALLBACK=false
FALLBACK2_MODEL=gemini-2.5-flash

ROUTER_MODEL=groq/llama-3.3-70b-versatile
ROUTER_API_KEY=YOUR_GROQ_KEY
ROUTER_ENDPOINT=https://api.groq.com/openai/v1

PRIMARY_MODEL=nvidia_nim/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
PRIMARY_API_KEY=YOUR_NVIDIA_KEY
PRIMARY_ENDPOINT=https://integrate.api.nvidia.com/v1

FALLBACK1_MODEL=nvidia_nim/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
FALLBACK1_API_KEY=YOUR_NVIDIA_KEY
FALLBACK1_ENDPOINT=https://integrate.api.nvidia.com/v1

REPORT_MODEL=groq/llama-3.3-70b-versatile
GROQ_API_KEY=YOUR_GROQ_KEY

TAVILY_API_KEY=YOUR_TAVILY_KEY

# ── Supervisor: Cerebras (separate from NVIDIA/Groq) ──────────────────
CEREBRAS_API_KEY=YOUR_CEREBRAS_KEY
SUPERVISOR_PRIMARY_MODEL=cerebras/gemma-4-31b
SUPERVISOR_FALLBACK_MODEL=gemini-2.5-flash

MAX_RETRIES_PRIMARY=2
REQUEST_TIMEOUT_SECONDS=240

# ── Upload Limits ────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=100
RATE_LIMIT_PER_MINUTE=20

# ── Preprocessing ───────────────────────────────────────────────────
IMAGE_TARGET_SIZE=384
CLAHE_CLIP_LIMIT=2.0
DENOISE_STRENGTH=10
ELA_QUALITY=95
VIDEO_MAX_FRAMES=30
VIDEO_INFORMATIVE_FRAMES=10

# ── CORS (production) ────────────────────────────────────────────────
FRONTEND_URL="https://your-vercel-app.vercel.app"
CORS_ORIGINS=""

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL="INFO"
