# ==================================================
# DeepGuard AI — Environment Configuration
# Copy this file to .env and fill in your API keys.
# ==================================================

# ── Sightengine (Analysis Primary — REST API deepfake detection) ──────────
# Sign up: https://sightengine.com/
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
# SIGHTENGINE_API_URL=https://api.sightengine.com/1.0/check.json  # optional override

# ── Groq (Router Agent Primary + Report Agent Primary) ────────────────────
# Sign up: https://console.groq.com/
GROQ_API_KEY=
ROUTER_API_KEY=                             # same as GROQ_API_KEY if using Groq
ROUTER_MODEL=groq/llama-3.3-70b-versatile
ROUTER_ENDPOINT=https://api.groq.com/openai/v1
REPORT_MODEL=groq/llama-3.3-70b-versatile

# ── NVIDIA NIM (Analysis Fallback 1+2, Router/Report fallbacks) ──────────
# Sign up: https://build.nvidia.com/  (one key works for all models)
PRIMARY_API_KEY=                            # Analysis Fallback 1 — Nemotron Omni
PRIMARY_MODEL=nvidia_nim/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
PRIMARY_ENDPOINT=https://integrate.api.nvidia.com/v1
FALLBACK1_API_KEY=                          # Analysis Fallback 2 — Nemotron Nano
FALLBACK1_MODEL=nvidia_nim/nvidia/nemotron-nano-12b-v2-vl
FALLBACK1_ENDPOINT=https://integrate.api.nvidia.com/v1

# Router fallback keys (same NVIDIA key, different models)
ROUTER_FALLBACK2_API_KEY=
ROUTER_FALLBACK2_MODEL=nvidia_nim/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
ROUTER_FALLBACK2_ENDPOINT=https://integrate.api.nvidia.com/v1
ROUTER_FALLBACK3_API_KEY=
ROUTER_FALLBACK3_MODEL=nvidia_nim/nvidia/nemotron-nano-12b-v2-vl
ROUTER_FALLBACK3_ENDPOINT=https://integrate.api.nvidia.com/v1

# Report fallback keys (same NVIDIA key, different models)
REPORT_FALLBACK2_API_KEY=
REPORT_FALLBACK2_MODEL=nvidia_nim/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
REPORT_FALLBACK2_ENDPOINT=https://integrate.api.nvidia.com/v1
REPORT_FALLBACK3_API_KEY=
REPORT_FALLBACK3_MODEL=nvidia_nim/nvidia/nemotron-nano-12b-v2-vl
REPORT_FALLBACK3_ENDPOINT=https://integrate.api.nvidia.com/v1

# ── Google / Gemini (Conditional Fallback for all 3 agents) ──────────────
# Get a key: https://aistudio.google.com/app/apikey
# Only used if ENABLE_GEMINI_FALLBACK=true
GOOGLE_API_KEY=
ENABLE_GEMINI_FALLBACK=false
FALLBACK2_MODEL=gemini-2.5-flash                    # Analysis Fallback 3
ROUTER_FALLBACK1_MODEL=gemini-2.5-flash              # Router Fallback 1
REPORT_FALLBACK1_MODEL=gemini-2.5-flash             # Report Fallback 1

# ── Tavily Web Search (Optional — Report Agent tool) ─────────────────────
# Sign up: https://tavily.com/
TAVILY_API_KEY=

# ── Pipeline Tuning ──────────────────────────────────────────────────────
MAX_RETRIES_PRIMARY=2
REQUEST_TIMEOUT_SECONDS=120
MAX_FILE_SIZE_MB=100
RATE_LIMIT_PER_MINUTE=20

# ── Preprocessing Defaults ───────────────────────────────────────────────
IMAGE_TARGET_SIZE=384
CLAHE_CLIP_LIMIT=2.0
DENOISE_STRENGTH=10
ELA_QUALITY=95
VIDEO_MAX_FRAMES=30
VIDEO_INFORMATIVE_FRAMES=10

# ── Security ─────────────────────────────────────────────────────────────
# PII_REDACTION_ENABLED=true
# INJECTION_DETECTION_ENABLED=true

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
